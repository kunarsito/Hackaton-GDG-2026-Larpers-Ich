# Puerto HTTP (el front espera 3000: http://localhost:3000/api)
PORT=3000

# Ruta del archivo SQLite (":memory:" para no persistir nada)
DB_PATH=./data/faro.db

# Motor del validador de retos:
#   auto   -> ejecuta Dart real si encuentra el SDK, si no usa el validador estático
#   dart   -> siempre Dart (falla si no hay SDK)
#   static -> sólo validación estática/heurística (sin ejecutar código)
CODE_RUNNER=auto

# Ruta explícita a dart.exe / dart (opcional). Si no se define se busca en PATH
# y dentro de flutter/bin/cache/dart-sdk/bin (mucho más rápido que el wrapper).
# DART_PATH=C:\src\flutter\bin\cache\dart-sdk\bin\dart.exe

# Tiempo máximo de ejecución de un reto en ms (RNF-01: < 2 s)
CODE_TIMEOUT_MS=2500

# Usuario demo que se usa cuando no llega cabecera x-user-id
DEMO_USER_ID=usr-001

# Login: contraseña de las cuentas de prueba de los usuarios semilla
# (ada@faro.dev, carlos@faro.dev, valeria@faro.dev, mateo@faro.dev, grace@faro.dev, linus@faro.dev)
DEMO_PASSWORD=faro1234

# true -> las rutas que identifican al usuario exigen sesión (Authorization: Bearer)
# false -> si no hay token se usa el modo invitado (x-user-id / usuario demo)
REQUIRE_AUTH=false
